VITE_TENOR_API_KEY=""
VITE_SENTRY_DSN="https://********************************@*****************.example.com/****************"
VITE_PLAUSIBLE_DOMAIN="example.tld"
VITE_PLAUSIBLE_ENDPOINT="https://plausible.example.tld/api/event"
# Hex pubkey of the nostr-push server (found in nostr-push startup logs as "worker_pubkey")
VITE_NOSTR_PUSH_PUBKEY=""
# Canonical origin used when generating shareable URLs (QR codes, copy-link, remote-login callbacks).
# Primarily useful for native (Capacitor) builds, where window.location.origin is capacitor://localhost.
# Example: VITE_SHARE_ORIGIN="https://2140.wtf"
VITE_SHARE_ORIGIN=""
# BAO Markets custom signet Mempool API (defaults to the public BAO mempool backend).
# Override this for local dev tunnels or when running a private electrs instance.
VITE_BAO_CUSTOM_SIGNET_MEMPOOL_URL="https://mempool.bao.markets/api"
# BAO Markets network filter for relay-first market discovery (kind 38000 `n`
# tag). Defaults to "demo" (the bao.markets signet demo network).
# VITE_BAO_MARKET_NETWORK="demo"
# Set to "*" to allow any host in the Vite dev server (eg. when proxying through a custom domain)
# ALLOWED_HOSTS="*"
# ── Pets (Nostr Pet) real-money rails ─────────────────────────────────────
# Nostr npub that receives real-Cashu (nutzap) payments from the Pets shop,
# egg adoption, and rerolls. Defaults to the 2140 treasury; override for dev.
VITE_PETS_TREASURY_NPUB=""
# Escrow operator for real-sats pet battles (kind 21124). Leave empty to keep
# real-sats battles disabled until the escrow service is deployed.
VITE_PETS_BATTLE_ESCROW_URL=""
VITE_PETS_BATTLE_ESCROW_PUBKEY=""
# TESTING ONLY: allow baby→adult evolution in ₿AO demo (signet) wallet mode.
# Dev builds allow it automatically; set "false" to restore the cashu-only
# gate in dev, "true" to allow demo evolution in a non-dev testing build.
# TODO(mainnet): remove before mainnet launch.
# VITE_PETS_DEMO_EVOLVE=""

# ── BAO Fund chat/fund API ────────────────────────────────────────────────
# The BAO Fund chat's room set (Trollbox + Public Chat) and campaign/pledge
# calls live behind the dedicated Fund API. The API's CORS + NIP-98 origin
# allowlist trusts app.bao.network / bao.fund only, so production must proxy
# /fund-api to it same-origin (dev does this in vite.config.ts).
# VITE_BAO_FUND_API_URL=/fund-api
# Canonical origin signed into the NIP-98 `u` tag when reaching the API
# through the same-origin proxy (must be an origin the API trusts).
# VITE_BAO_FUND_API_SIGN_ORIGIN=https://app.bao.network
#
# PRODUCTION NOTE: this app deploys to GitHub Pages (static), which cannot
# proxy /fund-api. The Fund API's CORS + NIP-98 allowlist trusts only
# app.bao.network / bao.fund. So production needs EITHER:
#   - the Fund API allowlist extended to https://2140.wtf (and localhost:3500
#     for dev), with VITE_BAO_FUND_API_URL=https://app.bao.network/fund-api
#     and no sign-origin override (cross-origin call), OR
#   - a host that can proxy /fund-api same-origin (Cloudflare/nginx) plus the
#     sign-origin override above.
# Otherwise the BAO chat/fund/court render but their API-backed data is empty.
